{
  "openapi": "3.1.0",
  "info": {
    "title": "Jisr Internal Testnet API",
    "version": "0.2.0",
    "description": "Testnet transfer tracking with service authentication and opt-in SEP-53 key-possession sessions. Read-only Horizon reconciliation; no signing or broadcasting."
  },
  "security": [
    {
      "serviceToken": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Database available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "network": {
                      "const": "TESTNET"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
