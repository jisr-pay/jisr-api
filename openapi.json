    "/v1/transfers/{hash}/reconcile": {
      "parameters": [
        {
          "name": "hash",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ],
      "post": {
        "responses": {
          "200": {
            "description": "Lookup result; uncertainty preserves state",
