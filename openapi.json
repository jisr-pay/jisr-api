        "description": "Sender must equal the authenticated wallet address. Registration is a claim, not payment evidence. New registrations require trusted network identity evidence to prevent transaction-hash squatting. Unknown or unavailable evidence returns 503; retain local history and retry. Failed transactions require verified transaction source. Identical existing retries do not require network availability.",
        "security": [
          {
            "walletSession": []
          }
        ]
      },
      "get": {
        "parameters": [
