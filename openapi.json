                    "record": {
                      "$ref": "#/components/schemas/Record"
                    },
                    "outcome": {
                      "enum": [
                        "pending",
                        "confirmed",
                        "failed",
                        "unknown",
                        "unavailable",
                        "invalid_evidence",
                        "unverified_payment"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected or unavailable; see error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or unavailable; see error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Request rejected or unavailable; see error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected or unavailable; see error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live adapter not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "walletSession": []
          }
        ],
        "description": "Returns 404 for absent transfers or another sender. Wallet sessions cannot access service-wide data."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-side credential; never expose to browsers."
      },
      "walletSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "15-minute wallet session from signed challenge; cannot access service routes."
      }
    },
    "schemas": {
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hash",
          "network",
          "asset",
          "sender",
          "recipient",
          "amount",
          "contractId",
          "submittedAt"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "network": {
            "const": "TESTNET"
          },
          "asset": {
            "const": "XLM"
          },
          "sender": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "recipient": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,7})?$",
            "description": "Positive exact decimal, at most 90000000000 XLM; never a JSON number."
          },
          "contractId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^C[A-Z2-7]{55}$",
            "description": "Explicit null for native XLM payments; checksummed C address for a contract claim. Immutable."
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Canonical UTC with milliseconds; at most five minutes in future."
          }
        }
      },
      "Record": {
        "type": "object",
        "required": [
          "hash",
          "network",
          "asset",
          "sender",
          "recipient",
          "amount",
          "contractId",
          "submittedAt",
          "status",
          "revision"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "network": {
            "const": "TESTNET"
          },
          "asset": {
            "const": "XLM"
          },
          "sender": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "recipient": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,7})?$",
            "description": "Positive exact decimal, at most 90000000000 XLM; never a JSON number."
          },
          "contractId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^C[A-Z2-7]{55}$",
            "description": "Explicit null for native XLM payments; checksummed C address for a contract claim. Immutable."
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Canonical UTC with milliseconds; at most five minutes in future."
          },
          "status": {
            "enum": [
              "pending",
              "confirmed",
              "failed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "settlement": {
            "$ref": "#/components/schemas/Settlement"
          }
        }
      },
      "Settlement": {
        "type": "object",
        "required": [
          "hash",
          "successful",
          "feeCharged",
          "ledger",
          "createdAt"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "successful": {
            "type": "boolean"
          },
          "feeCharged": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{7} XLM$"
          },
          "ledger": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "WalletChallengeInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          }
        }
      },
      "WalletChallenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "address",
          "message",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "address": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "message": {
            "type": "string",
            "description": "Sign this exact UTF-8 text using SEP-53; do not alter or prefix it yourself."
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          }
        }
      },
      "WalletProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signature"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      },
      "WalletSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "address",
          "expiresAt"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "address": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$",
            "description": "Checksummed Stellar Ed25519 public address."
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          }
        }
      }
    }
  }
}
