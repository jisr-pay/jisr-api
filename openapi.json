{
  "openapi": "3.1.0",
  "info": {
    "title": "Jisr Internal Testnet API",
    "version": "0.1.0",
    "description": "Service-only foundation. No wallet authentication or live SDK adapter yet."
  },
  "security": [
    {
      "serviceToken": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Database available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "network": {
                      "const": "TESTNET"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transfers": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical retry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "record"
                  ],
                  "properties": {
                    "record": {
                      "$ref": "#/components/schemas/Record"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Registered pending transfer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "record"
                  ],
                  "properties": {
                    "record": {
                      "$ref": "#/components/schemas/Record"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Immutable identity conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transfers/{hash}": {
      "parameters": [
        {
          "name": "hash",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Registered transfer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "record"
                  ],
                  "properties": {
                    "record": {
                      "$ref": "#/components/schemas/Record"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transfers/{hash}/reconcile": {
      "parameters": [
        {
          "name": "hash",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ],
      "post": {
        "responses": {
          "200": {
            "description": "Lookup result; uncertainty preserves state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "record",
                    "outcome"
                  ],
                  "properties": {
                    "record": {
                      "$ref": "#/components/schemas/Record"
                    },
                    "outcome": {
                      "enum": [
                        "pending",
                        "confirmed",
                        "failed",
                        "unknown",
                        "unavailable",
                        "invalid_evidence",
                        "unverified_payment"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live adapter not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-side credential; never expose to browsers."
      }
    },
    "schemas": {
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hash",
          "network",
          "asset",
          "sender",
          "recipient",
          "amount",
          "contractId",
          "submittedAt"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "network": {
            "const": "TESTNET"
          },
          "asset": {
            "const": "XLM"
          },
          "sender": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          },
          "recipient": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,7})?$",
            "description": "Must be positive."
          },
          "contractId": {
            "type": "string",
            "pattern": "^C[A-Z2-7]{55}$"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Canonical UTC with milliseconds; at most five minutes in future."
          }
        }
      },
      "Record": {
        "type": "object",
        "required": [
          "hash",
          "network",
          "asset",
          "sender",
          "recipient",
          "amount",
          "contractId",
          "submittedAt",
          "status",
          "revision"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "network": {
            "const": "TESTNET"
          },
          "asset": {
            "const": "XLM"
          },
          "sender": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          },
          "recipient": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,7})?$",
            "description": "Must be positive."
          },
          "contractId": {
            "type": "string",
            "pattern": "^C[A-Z2-7]{55}$"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Canonical UTC with milliseconds; at most five minutes in future."
          },
          "status": {
            "enum": [
              "pending",
              "confirmed",
              "failed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "settlement": {
            "$ref": "#/components/schemas/Settlement"
          }
        }
      },
      "Settlement": {
        "type": "object",
        "required": [
          "hash",
          "successful",
          "feeCharged",
          "ledger",
          "createdAt"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "successful": {
            "type": "boolean"
          },
          "feeCharged": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{7} XLM$"
          },
          "ledger": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
