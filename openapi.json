                  "type": "object",
                  "required": [
                    "record",
                    "outcome"
                  ],
                  "properties": {
                    "record": {
                      "$ref": "#/components/schemas/Record"
                    },
                    "outcome": {
                      "enum": [
                        "pending",
                        "confirmed",
                        "failed",
                        "unknown",
                        "unavailable",
                        "invalid_evidence",
                        "unverified_payment"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
