            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "description": "Sender-scoped history ordered by hash, up to 50 records per page. Pass nextCursor as after.",
        "responses": {
          "200": {
