HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/transfers.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=
# Optional: enable the live SettlementAdapter against Horizon Testnet
# HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: enable wallet sessions behind this exact same browser origin
# WALLET_AUTH_ORIGIN=http://localhost:24519

# Optional router evidence: configure all values together with HORIZON_URL.
# This October 8 Testnet fixture uses a disposable demo treasury, not an operational wallet.
